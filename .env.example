# 咖啡探索搭子 —— 环境配置（复制为 .env 后填写）
# 密钥只保存在本机 .env，不要提交或分发。

# 模型服务：DeepSeek 的 Anthropic 兼容网关（推荐，便宜）
ANTHROPIC_API_KEY=sk-你的key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
MODEL_ID=deepseek-chat

# 可选：高德开放平台 Web 服务 Key（用于搜索附近咖啡馆）
# 不填也能用：外部搜索会自动降级为「仅本地记录推荐」
# 申请：https://console.amap.com/
AMAP_API_KEY=

# 可选：网页照片识别。填写支持图片输入的服务完整 HTTPS 接口地址。
# 协议需兼容 chat-completions；未配置时手动记录仍可用。
VISION_ENDPOINT=
VISION_API_KEY=
VISION_MODEL=
